# Python environment
venv/
env/
__pycache__/
*.pyc

# Secrets — never commit (copy .env.example instead)
.env

# Data: the database, its backups and uploaded files hold customers' personal details
*.sqlite3
*.sqlite3-journal
*.bak
# Copies made before migrations / data changes (db.sqlite3.bak-before-<what>)
*.sqlite3.bak*
media/
media_backup/
staticfiles/

# Downloaded model caches
.cache/

# Database backups (manage.py backup_db / daily_maintenance)
backups/

# Data exports for the move to Postgres (manage.py dumpdata): customers' personal details
dump.json
dump-*.json
