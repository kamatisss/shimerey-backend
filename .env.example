# Copy this file to .env and fill in your values.
# The .env file is git-ignored — never commit real secrets.

# ─── Django ──────────────────────────────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=paste-a-long-random-key-here
# Production only (config/settings/prod.py, used by the web server):
# ALLOWED_HOSTS=yourname.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app      (defaults to FRONTEND_URL)
# DJANGO_DEBUG=false

# ─── PayMongo (QR Ph / GCash / Maya / Card) ─────────────────────────────────────
# Get from https://dashboard.paymongo.com > Developers > API Keys (use sk_test_ while developing)
PAYMONGO_SECRET_KEY=sk_test_YOUR_KEY_HERE
# Created when you register a webhook (needs a public HTTPS URL):
#   https://<your-domain>/api/paymongo-webhook/  event: checkout_session.payment.paid
# Optional on localhost: the receipt page checks PayMongo directly instead.
PAYMONGO_WEBHOOK_SECRET=
# Optional overrides
# PAYMONGO_PAYMENT_METHODS=qrph,gcash,paymaya,card,grab_pay
# PAYMONGO_ORDER_TTL_MINUTES=60

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Email (password reset links, payment links, crew alerts) ───────────────────────────────────────────────────
# Leave EMAIL_HOST_USER empty while developing: emails are printed in the Django terminal.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
# EMAIL_HOST_USER=yourbusiness@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# Optional (defaults shown); other providers (Brevo, SES, ...) just change these
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Garden Studio <yourbusiness@gmail.com>

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Optional: AI_MODE=hybrid|ai|rules  (see apps/library/garden_ai.py)

# ─── Web Push (crew phone alerts) ────────────────────────────────────────────
# Generate once and keep: changing them signs every phone out of alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourbusiness.ph

# ─── Limits (optional) ───────────────────────────────────────────────────────
# LOGINS_PER_MINUTE=10
